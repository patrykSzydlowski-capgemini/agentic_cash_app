<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:ce="sap.ui.codeeditor"
    height="100%"
    displayBlock="true">

    <VBox id="aiContextViewerBox" class="sapUiSmallMargin">
        <Panel id="panelAiRationale"
               headerText="{i18n>fieldRationale}"
               expandable="true"
               expanded="true"
               visible="{= !!${rationale} }">
            <ce:CodeEditor id="editorAiRationale"
                           type="text"
                           value="{rationale}"
                           maxLines="15"
                           editable="false"
                           syntaxHints="false" />
        </Panel>

        <Panel id="panelRawPaymentPayload"
               headerText="{i18n>facetPaymentDetails}"
               expandable="true"
               expanded="false">
            <ce:CodeEditor id="editorPaymentSummary"
                           type="json"
                           value="{= '{\n  &quot;paymentId&quot;: &quot;' + ${ID} + '&quot;,\n  &quot;payer&quot;: &quot;' + ${payer} + '&quot;,\n  &quot;amount&quot;: ' + ${amount} + ',\n  &quot;currency&quot;: &quot;' + ${currency} + '&quot;,\n  &quot;valueDate&quot;: &quot;' + ${valueDate} + '&quot;,\n  &quot;status&quot;: &quot;' + ${status} + '&quot;,\n  &quot;aiModel&quot;: &quot;' + ${aiModel} + '&quot;,\n  &quot;extractionConfidence&quot;: ' + ${extractionConfidence} + '\n}' }"
                           maxLines="15"
                           editable="false"
                           syntaxHints="false" />
        </Panel>
    </VBox>
</core:FragmentDefinition>
