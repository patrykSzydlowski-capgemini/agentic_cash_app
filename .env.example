# Real AI via OpenRouter (OpenAI-compatible API) — copy to .env and fill in.
# .env is git-ignored; never commit real keys.
CASH_AI_ENABLED=true

# Your OpenRouter API key (https://openrouter.ai/keys):
OPENROUTER_API_KEY=sk-or-v1-...

# Default model is a FREE OpenRouter tier; override if needed:
# OPENROUTER_MODEL=thinkingmachines/inkling-small:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
