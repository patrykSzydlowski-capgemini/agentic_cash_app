{
  "name": "poc_cash",
  "version": "1.0.0",
  "description": "AI Agent Cash Matching Dashboard",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cap-js/sqlite": "^3.1.0",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap/cds": "^10.1.0",
    "axios": "^1.20.0",
    "express": "^4",
    "imap": "^0.8.19",
    "mailparser": "^3.9.28",
    "npx": "^10.2.2"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.19.0",
    "@sap/cds-dk": "^10.1.1",
    "@types/imap": "^0.8.43",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.13.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "dev": "cds watch --in-memory",
    "pretypecheck": "npm run cds:types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:all": "tsc -p tsconfig.all.json --noEmit",
    "cds:types": "cds-typer \"*\" --outputDirectory @cds-models",
    "test": "node --import tsx --test test/*.test.ts",
    "pretypecheck:all": "npm run cds:types",
    "pretest:built": "npm run build:server",
    "test:built": "node --import tsx --test test/*.test.ts",
    "build:server": "cds build --production"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite"
      }
    },
    "build": {
      "tasks": [
        {
          "for": "typescript",
          "src": ".",
          "options": {
            "model": [
              "db",
              "srv",
              "app",
              "app/*",
              "@sap/cds/srv/outbox",
              "."
            ]
          }
        },
        {
          "for": "nodejs",
          "src": "srv",
          "options": {
            "model": [
              "db",
              "srv",
              "app",
              "app/*",
              "@sap/cds/srv/outbox"
            ]
          }
        }
      ]
    }
  }
}
