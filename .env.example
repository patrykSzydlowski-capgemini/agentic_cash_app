# Copy to root .env: cp .env.example .env — never commit real keys.
# Then: 1) paste your key into OPENROUTER_API_KEY
#       2) set CASH_AI_ENABLED=true
#       3) restart the server (npm run dev).
CASH_AI_ENABLED=false
CASH_AI_PROVIDER=openrouter
CASH_S4_ENABLED=false

# https://openrouter.ai/keys — paste your key here in .env, not this file.
OPENROUTER_API_KEY=
# Choose a currently available model; PDF support and pricing must be checked.
# OPENROUTER_MODEL=provider/model-id
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# CF user-provided service name (default):
# CASH_AI_BINDING_NAME=poc-cash-ai

# Optional SAP AI Core: set CASH_AI_PROVIDER=aicore.
# Local: complete service-key JSON on ONE line, single-quoted.
# AICORE_SERVICE_KEY='{"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"AI_API_URL":"..."}}'
# AICORE_MODEL=your-enabled-model
# AICORE_RESOURCE_GROUP=default
# In CF prefer a native AI Core service binding; no service key in MTAR.
