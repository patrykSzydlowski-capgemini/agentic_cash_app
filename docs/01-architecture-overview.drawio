<mxfile host="app.diagrams.net">
  <diagram id="arch-overview" name="Architecture Overview">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- External sources -->
        <mxCell id="mailbox" value="AR Shared Mailbox&#10;(Exchange Online / Graph API)&#10;remittance advices, bank-statement PDFs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bankfeed" value="Bank statement feed&#10;(e.g. SAP Multi-Bank Connectivity /&#10;bank SFTP - optional 2nd source)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="160" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Actor -->
        <mxCell id="user" value="AR Accountant&#10;(reviews &amp; approves only;&#10;manual upload = fallback)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="420" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- BTP container -->
        <mxCell id="btp" value="SAP BTP Subaccount (Cloud Foundry)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=6;dashed=1;fillColor=none;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="980" height="600" as="geometry" />
        </mxCell>

        <!-- Scheduler -->
        <mxCell id="sched" value="Scheduler&#10;(in-process cron in the CAP app)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="330" y="60" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Agent 1 Ingestion -->
        <mxCell id="agent0" value="Agent 1: Ingestion Agent&#10;skills: read mailbox, read bank&#10;statement feed &#8594; classify relevant&#10;vs. irrelevant, fetch attachment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- Agent 2 Extraction -->
        <mxCell id="agent1" value="Agent 2: Extraction Agent&#10;reads PDFs of varying formats&#10;&#8594; structured payment data via&#10;Claude document understanding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="280" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- Agent 3 Matching -->
        <mxCell id="agent2" value="Agent 3: Matching Agent&#10;scores &amp; reasons about payment&#10;&#8596; open item matches, assigns&#10;status: Full / Probable / To be&#10;checked / No match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="410" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- CAP service -->
        <mxCell id="cap" value="CAP Service (Node.js + TypeScript)&#10;- Payments / ProposedMatches (CDS, OData)&#10;- Ingestion log&#10;- Approval &amp; posting workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="620" y="150" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- UI -->
        <mxCell id="ui" value="Web UI (HTML/TS SPA)&#10;- Open Items list&#10;- Ingestion log&#10;- Matching queue with status badges&#10;- Approve / Reject / Post&#10;- Manual upload (fallback only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="280" width="230" height="120" as="geometry" />
        </mxCell>

        <!-- DB -->
        <mxCell id="db" value="Persistence&#10;(SAP HANA Cloud, free tier instance)&#10;Payments, ProposedMatches, ingestion &amp; audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="620" y="420" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- XSUAA -->
        <mxCell id="xsuaa" value="XSUAA (Authentication)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="620" y="510" width="230" height="50" as="geometry" />
        </mxCell>

        <!-- Generative AI Hub -->
        <mxCell id="genai" value="SAP AI Core /&#10;Generative AI Hub&#10;(orchestration + Claude Sonnet,&#10;shared by all three agents)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="920" y="280" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- Destination service -->
        <mxCell id="dest" value="Destination Service&#10;(mailbox/Graph API, bank feed,&#10;S/4 read, S/4 write - one abstraction&#10;for every outbound call)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="920" y="60" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- S/4 read -->
        <mxCell id="s4read" value="S/4HANA Public Cloud&#10;Open Items API (read)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1320" y="380" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- S/4 write -->
        <mxCell id="s4write" value="S/4HANA Public Cloud&#10;Clearing / posting API (write)&#10;&#8212; validate in Sprint 0 &#8212;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1320" y="470" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e0a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="sched" target="agent0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e0b" value="poll" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="agent0" target="mailbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e0c" value="poll (optional)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="agent0" target="bankfeed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e0d" value="new document" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="agent0" target="agent1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="structured payment(s)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="agent1" target="agent2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="open items + payment / proposed matches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="agent2" target="cap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="agent0" target="cap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="cap" target="ui"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ui" target="user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="manual upload (fallback)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="user" target="agent1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="cap" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="cap" target="xsuaa"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="agent1" target="genai"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="agent2" target="genai"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="agent0" target="genai"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="agent0" target="dest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="read open items" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="agent2" target="dest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="dest" target="s4read"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="post clearance&#10;(after human approval)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="cap" target="s4write"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
