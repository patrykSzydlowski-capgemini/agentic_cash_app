<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:cssgrid="sap.ui.layout.cssgrid"
    xmlns:form="sap.ui.layout.form"
    xmlns:f="sap.f">
    <Dialog
        id="aiKpiDialog"
        title="{i18n>kpiDialogTitle}"
        contentWidth="920px"
        contentHeight="auto"
        resizable="true"
        draggable="true">
        <content>
            <VBox class="sapUiMediumMargin">
                <!-- 2x2 KPI cards: totals over all finished pipeline runs -->
                <cssgrid:CSSGrid
                    gridTemplateColumns="repeat(auto-fit, minmax(360px, 1fr))"
                    gridGap="1rem"
                    class="sapUiSmallMarginBottom">
                    <!-- Card 1: Pipeline runs -->
                    <f:Card>
                        <f:content>
                            <VBox class="sapUiMediumMargin">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <Title text="{i18n>kpiTotalRuns}" level="H4" titleStyle="H5" wrapping="true" />
                                    <core:Icon
                                        src="sap-icon://process"
                                        size="1.5rem"
                                        color="Neutral"
                                        decorative="true" />
                                </HBox>
                                <HBox alignItems="Baseline" class="sapUiSmallMarginTopBottom">
                                    <ObjectNumber
                                        number="{kpi>/totalRunsFormatted}"
                                        unit="runs"
                                        state="None"
                                        emphasized="true"
                                        class="sapMObjectNumberLarge" />
                                </HBox>
                                <Text
                                    text="{i18n>kpiTotalRunsSubtitle}"
                                    class="sapUiTextSecondary"
                                    wrapping="true" />
                            </VBox>
                        </f:content>
                    </f:Card>
                    <!-- Card 2: Total token volume -->
                    <f:Card>
                        <f:content>
                            <VBox class="sapUiMediumMargin">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <Title text="{i18n>kpiTotalTokens}" level="H4" titleStyle="H5" wrapping="true" />
                                    <core:Icon
                                        src="sap-icon://chart-axis"
                                        size="1.5rem"
                                        color="Marker"
                                        decorative="true" />
                                </HBox>
                                <HBox alignItems="Baseline" class="sapUiSmallMarginTopBottom">
                                    <ObjectNumber
                                        number="{kpi>/totalTokensFormatted}"
                                        unit="tokens"
                                        state="Success"
                                        emphasized="true"
                                        class="sapMObjectNumberLarge" />
                                </HBox>
                                <Text
                                    text="{i18n>kpiTotalTokensSubtitle}"
                                    class="sapUiTextSecondary"
                                    wrapping="true" />
                            </VBox>
                        </f:content>
                    </f:Card>
                    <!-- Card 3: Estimated model cost -->
                    <f:Card>
                        <f:content>
                            <VBox class="sapUiMediumMargin">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <Title text="{i18n>kpiTotalCost}" level="H4" titleStyle="H5" wrapping="true" />
                                    <core:Icon
                                        src="sap-icon://money-bills"
                                        size="1.5rem"
                                        color="Critical"
                                        decorative="true" />
                                </HBox>
                                <HBox alignItems="Baseline" class="sapUiSmallMarginTopBottom">
                                    <ObjectNumber
                                        number="{kpi>/totalCostFormattedWithCurrency}"
                                        unit="USD"
                                        state="Warning"
                                        emphasized="true"
                                        class="sapMObjectNumberLarge" />
                                </HBox>
                                <Text
                                    text="{i18n>kpiTotalCostSubtitle}"
                                    class="sapUiTextSecondary"
                                    wrapping="true" />
                            </VBox>
                        </f:content>
                    </f:Card>
                    <!-- Card 4: Files extracted -->
                    <f:Card>
                        <f:content>
                            <VBox class="sapUiMediumMargin">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <Title text="{i18n>kpiFilesExtracted}" level="H4" titleStyle="H5" wrapping="true" />
                                    <core:Icon
                                        src="sap-icon://document-text"
                                        size="1.5rem"
                                        color="Neutral"
                                        decorative="true" />
                                </HBox>
                                <HBox alignItems="Baseline" class="sapUiSmallMarginTopBottom">
                                    <ObjectNumber
                                        number="{kpi>/totalFilesExtractedFormatted}"
                                        unit="PDF"
                                        state="None"
                                        emphasized="true"
                                        class="sapMObjectNumberLarge" />
                                </HBox>
                                <Text
                                    text="{i18n>kpiFilesExtractedSubtitle}"
                                    class="sapUiTextSecondary"
                                    wrapping="true" />
                            </VBox>
                        </f:content>
                    </f:Card>
                </cssgrid:CSSGrid>

                <!-- Breakdown: per-run averages/medians, last run, totals -->
                <form:SimpleForm
                    title="{i18n>tabAiAnalytics}"
                    editable="false"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="12"
                    labelSpanL="12"
                    labelSpanM="12"
                    labelSpanS="12"
                    columnsXL="3"
                    columnsL="3"
                    columnsM="1"
                    class="sapUiSmallMarginTop">
                    <form:content>
                        <!-- Per-run averages / medians -->
                        <core:Title text="{i18n>kpiGroupPerRun}" />
                        <Label text="{i18n>kpiAvgDuration}" />
                        <Text text="{kpi>/avgDurationSec} s" />

                        <Label text="{i18n>kpiMedianDuration}" />
                        <Text text="{kpi>/medianDurationSec} s" />

                        <Label text="{i18n>kpiAvgTokens}" />
                        <Text text="{kpi>/avgTokensPerRunFormatted}" />

                        <Label text="{i18n>kpiMedianTokens}" />
                        <Text text="{kpi>/medianTokensPerRunFormatted}" />

                        <Label text="{i18n>kpiAvgCost}" />
                        <Text text="{kpi>/avgCostFormattedWithCurrency} USD" />

                        <Label text="{i18n>kpiAvgTokensPerFile}" />
                        <Text text="{kpi>/avgTokensPerFileFormatted}" />

                        <!-- Last finished run -->
                        <core:Title text="{i18n>kpiGroupLastRun}" />
                        <Label text="{i18n>kpiLastRunAt}" />
                        <Text text="{kpi>/lastRunAt}" />

                        <Label text="{i18n>fieldRunDuration}" />
                        <Text text="{kpi>/lastRunDurationMsFormatted} ms" />

                        <Label text="{i18n>fieldTotalTokens}" />
                        <Text text="{kpi>/lastRunTokensFormatted}" />

                        <Label text="{i18n>fieldRunOpenItemsOpen}" />
                        <Text text="{kpi>/lastRunOpenItemsFormatted}" />

                        <!-- Totals over all runs -->
                        <core:Title text="{i18n>kpiGroupTotals}" />
                        <Label text="{i18n>kpiActiveModel}" />
                        <Text text="{kpi>/activeModel}" />

                        <Label text="{i18n>kpiFailedRuns}" />
                        <Text text="{kpi>/failedRunsFormatted}" />

                        <Label text="{i18n>fieldRunAiCalls}" />
                        <Text text="{kpi>/totalAiCallsFormatted}" />

                        <Label text="{i18n>kpiPromptTokensBreakdown}" />
                        <Text text="{kpi>/totalPromptTokensFormatted}" />

                        <Label text="{i18n>kpiCompletionTokensBreakdown}" />
                        <Text text="{kpi>/totalCompletionTokensFormatted}" />

                        <Label text="{i18n>kpiTotalCapacityUnits}" />
                        <Text text="{kpi>/totalCapacityUnitsFormatted} CU" />

                        <Label text="{i18n>fieldRunPaymentsEvaluated}" />
                        <Text text="{kpi>/totalPaymentsEvaluatedFormatted}" />

                        <Label text="{i18n>fieldRunPaymentsMatched}" />
                        <Text text="{kpi>/totalPaymentsMatchedFormatted}" />
                    </form:content>
                </form:SimpleForm>

                <!-- Tariff & Billing Disclaimer Note -->
                <MessageStrip
                    text="{i18n>kpiTariffDisclaimer}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginTop" />
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>actionRefreshStats}"
                icon="sap-icon://refresh"
                type="Emphasized"
                press=".onRefreshKpiData" />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>btnClose}"
                press=".onCloseKpiDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
