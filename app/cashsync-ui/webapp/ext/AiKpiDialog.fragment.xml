<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:cssgrid="sap.ui.layout.cssgrid"
    xmlns:form="sap.ui.layout.form"
    xmlns:f="sap.f">
    <Dialog
        id="aiKpiDialog"
        title="{i18n>kpiDialogTitle}"
        contentWidth="920px"
        contentHeight="auto"
        resizable="true"
        draggable="true">
        <content>
            <VBox class="sapUiMediumMargin">
                <!-- 2x2 Bento KPI Cards Grid: Generous ~420px width per card, zero truncation, balanced semantic rows -->
                <cssgrid:CSSGrid
                    gridTemplateColumns="repeat(auto-fit, minmax(360px, 1fr))"
                    gridGap="1rem"
                    class="sapUiSmallMarginBottom">
                    <!-- Card 1: Total Token Volume -->
                    <f:Card>
                        <f:content>
                            <VBox class="sapUiMediumMargin">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <Title text="{i18n>kpiTotalTokens}" level="H4" titleStyle="H5" wrapping="true" />
                                    <core:Icon
                                        src="sap-icon://chart-axis"
                                        size="1.5rem"
                                        color="Marker"
                                        decorative="true" />
                                </HBox>
                                <HBox alignItems="Baseline" class="sapUiSmallMarginTopBottom">
                                    <ObjectNumber
                                        number="{kpi>/totalTokensFormatted}"
                                        unit="tokens"
                                        state="Success"
                                        emphasized="true"
                                        class="sapMObjectNumberLarge" />
                                </HBox>
                                <Text
                                    text="{i18n>kpiTotalTokensSubtitle}"
                                    class="sapUiTextSecondary"
                                    wrapping="true" />
                            </VBox>
                        </f:content>
                    </f:Card>

                    <!-- Card 2: SAP Capacity Units -->
                    <f:Card>
                        <f:content>
                            <VBox class="sapUiMediumMargin">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <Title text="{i18n>kpiTotalCapacityUnits}" level="H4" titleStyle="H5" wrapping="true" />
                                    <core:Icon
                                        src="sap-icon://performance"
                                        size="1.5rem"
                                        color="Positive"
                                        decorative="true" />
                                </HBox>
                                <HBox alignItems="Baseline" class="sapUiSmallMarginTopBottom">
                                    <ObjectNumber
                                        number="{kpi>/totalCapacityUnitsFormatted}"
                                        unit="CU"
                                        state="Success"
                                        emphasized="true"
                                        class="sapMObjectNumberLarge" />
                                </HBox>
                                <Text
                                    text="{i18n>kpiTotalCapacityUnitsSubtitle}"
                                    class="sapUiTextSecondary"
                                    wrapping="true" />
                            </VBox>
                        </f:content>
                    </f:Card>

                    <!-- Card 3: Estimated Model Cost -->
                    <f:Card>
                        <f:content>
                            <VBox class="sapUiMediumMargin">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <Title text="{i18n>kpiTotalCost}" level="H4" titleStyle="H5" wrapping="true" />
                                    <core:Icon
                                        src="sap-icon://money-bills"
                                        size="1.5rem"
                                        color="Critical"
                                        decorative="true" />
                                </HBox>
                                <HBox alignItems="Baseline" class="sapUiSmallMarginTopBottom">
                                    <ObjectNumber
                                        number="{kpi>/totalCostFormattedWithCurrency}"
                                        unit="USD"
                                        state="Warning"
                                        emphasized="true"
                                        class="sapMObjectNumberLarge" />
                                </HBox>
                                <Text
                                    text="{i18n>kpiTotalCostSubtitle}"
                                    class="sapUiTextSecondary"
                                    wrapping="true" />
                            </VBox>
                        </f:content>
                    </f:Card>

                    <!-- Card 4: Processed Invoices -->
                    <f:Card>
                        <f:content>
                            <VBox class="sapUiMediumMargin">
                                <HBox justifyContent="SpaceBetween" alignItems="Center">
                                    <Title text="{i18n>kpiProcessedPayments}" level="H4" titleStyle="H5" wrapping="true" />
                                    <core:Icon
                                        src="sap-icon://document-text"
                                        size="1.5rem"
                                        color="Neutral"
                                        decorative="true" />
                                </HBox>
                                <HBox alignItems="Baseline" class="sapUiSmallMarginTopBottom">
                                    <ObjectNumber
                                        number="{kpi>/totalProcessedFormatted}"
                                        unit="docs"
                                        state="None"
                                        emphasized="true"
                                        class="sapMObjectNumberLarge" />
                                </HBox>
                                <Text
                                    text="{i18n>kpiProcessedSubtitle}"
                                    class="sapUiTextSecondary"
                                    wrapping="true" />
                            </VBox>
                        </f:content>
                    </f:Card>
                </cssgrid:CSSGrid>

                <!-- Detailed Breakdown Form: Averages, Medians, Telemetry -->
                <form:SimpleForm
                    title="{i18n>tabAiAnalytics}"
                    editable="false"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="12"
                    labelSpanL="12"
                    labelSpanM="12"
                    labelSpanS="12"
                    columnsXL="3"
                    columnsL="3"
                    columnsM="1"
                    class="sapUiSmallMarginTop">
                    <form:content>
                        <!-- Averages Section -->
                        <core:Title text="{i18n>kpiGroupAverages}" />
                        <Label text="{i18n>kpiAvgTokens}" />
                        <Text text="{kpi>/avgTokensPerPaymentFormatted} ({kpi>/avgPromptTokensFormatted} in / {kpi>/avgCompletionTokensFormatted} out)" />

                        <Label text="{i18n>kpiAvgDuration}" />
                        <Text text="{kpi>/avgProcessingTimeSec} s ({kpi>/avgProcessingTimeMs} ms)" />

                        <Label text="{i18n>kpiAvgCost}" />
                        <Text text="{kpi>/avgCostFormattedWithCurrency} USD" />

                        <Label text="{i18n>kpiAvgCU}" />
                        <Text text="{kpi>/avgCapacityUnitsFormatted} CU" />

                        <!-- Medians Section -->
                        <core:Title text="{i18n>kpiGroupMedians}" />
                        <Label text="{i18n>kpiMedianTokens}" />
                        <Text text="{kpi>/medianTokensPerPaymentFormatted} ({kpi>/medianPromptTokensFormatted} in / {kpi>/medianCompletionTokensFormatted} out)" />

                        <Label text="{i18n>kpiMedianDuration}" />
                        <Text text="{kpi>/medianProcessingTimeSec} s ({kpi>/medianProcessingTimeMs} ms)" />

                        <Label text="{i18n>kpiMedianCost}" />
                        <Text text="{kpi>/medianCostFormattedWithCurrency} USD" />

                        <Label text="{i18n>kpiMedianCU}" />
                        <Text text="{kpi>/medianCapacityUnitsFormatted} CU" />

                        <!-- Global Details -->
                        <core:Title text="{i18n>aiAnalyticsTypeNamePlural}" />
                        <Label text="{i18n>kpiActiveModel}" />
                        <Text text="{kpi>/activeModel}" />

                        <Label text="{i18n>kpiPromptTokensBreakdown}" />
                        <Text text="{kpi>/totalPromptTokensFormatted}" />

                        <Label text="{i18n>kpiCompletionTokensBreakdown}" />
                        <Text text="{kpi>/totalCompletionTokensFormatted}" />
                    </form:content>
                </form:SimpleForm>

                <!-- Tariff & Billing Disclaimer Note -->
                <MessageStrip
                    text="{i18n>kpiTariffDisclaimer}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginTop" />
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>actionRefreshStats}"
                icon="sap-icon://refresh"
                type="Emphasized"
                press=".onRefreshKpiData" />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>btnClose}"
                press=".onCloseKpiDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
