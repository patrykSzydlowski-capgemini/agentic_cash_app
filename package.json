{
  "name": "poc_cash",
  "version": "1.0.0",
  "description": "AI Agent Cash Matching Dashboard",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cap-js/sqlite": "^3.1.0",
    "@sap-ai-sdk/orchestration": "^2.15.0",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap/cds": "^10.1.0",
    "express": "^4",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "npx": "^10.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.19.0",
    "@sap/cds-dk": "^10.1.1",
    "@types/imapflow": "^1.0.23",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.13.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds bind --exec -- cds watch",
    "dev": "cds bind --exec -- cds watch --in-memory",
    "pretypecheck": "npm run cds:types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:all": "tsc -p tsconfig.all.json --noEmit",
    "cds:types": "cds-typer \"*\" --outputDirectory @cds-models",
    "test": "node --import tsx --test test/*.test.ts",
    "pretypecheck:all": "npm run cds:types",
    "pretest:built": "npm run build:server",
    "test:built": "node --import tsx --test test/*.test.ts",
    "build:server": "cds build --production",
    "ai:check": "cds bind --exec -- node --import tsx scripts/live-ai-check.ts",
    "ai:process": "node --import tsx scripts/process-payment.ts",
    "ai:cf:create": "node --import tsx scripts/configure-ai-cf.ts create",
    "ai:cf:update": "node --import tsx scripts/configure-ai-cf.ts update"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite"
      },
      "poc-cash-ai": {
        "kind": "user-provided",
        "vcap": {
          "name": "poc-cash-ai"
        }
      },
      "AICORE_DESTINATION": {
        "kind": "rest",
        "credentials": {
          "destination": "AICORE_DESTINATION"
        }
      },
      "ZAC_OPENITEMS_MOC_O4": {
        "kind": "odata-v4",
        "model": "srv/external/ZAC_OPENITEMS_MOC_O4",
        "credentials": {
          "destination": "HD0_BAS",
          "path": "/sap/opu/odata4/sap/zac_openitems_moc_o4/srvd_a2x/sap/zac_openitems_moc/0001"
        }
      }
    },
    "build": {
      "tasks": [
        {
          "for": "typescript",
          "src": ".",
          "options": {
            "model": [
              "db",
              "srv",
              "app",
              "app/*",
              "@sap/cds/srv/outbox",
              "."
            ]
          }
        },
        {
          "for": "nodejs",
          "src": "srv",
          "options": {
            "model": [
              "db",
              "srv",
              "app",
              "app/*",
              "@sap/cds/srv/outbox"
            ]
          }
        }
      ]
    }
  }
}
