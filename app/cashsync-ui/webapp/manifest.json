{
  "_version": "1.89.0",
  "sap.app": {
    "id": "poc.cash.cashsyncui",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        "",
        "en",
        "de",
        "pl"
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/cash-sync/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "sap.fe.templates.RootContainer.view.Fcl",
      "type": "XML",
      "id": "appRootView"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.f": {},
        "sap.ui.unified": {},
        "sap.ui.codeeditor": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "poc.cash.cashsyncui.i18n.i18n",
          "supportedLocales": [
            "",
            "en",
            "de",
            "pl"
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {
        "fullWidth": true,
        "routerClass": "sap.f.routing.Router"
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "PaymentsList",
          "target": "PaymentsList"
        },
        {
          "pattern": "Payments({key}):?query:",
          "name": "PaymentsObjectPage",
          "target": [
            "PaymentsList",
            "PaymentsObjectPage"
          ]
        },
        {
          "pattern": "OpenItem({key}):?query:",
          "name": "OpenItemObjectPage",
          "target": [
            "PaymentsList",
            "OpenItemObjectPage"
          ]
        },
        {
          "pattern": "PipelineRuns({key}):?query:",
          "name": "PipelineRunsObjectPage",
          "target": [
            "PaymentsList",
            "PipelineRunsObjectPage"
          ]
        },
        {
          "pattern": "MatchResult:?query:",
          "name": "MatchResultList",
          "target": "MatchResultList"
        },
        {
          "pattern": "MatchResult({key}):?query:",
          "name": "MatchResultObjectPage",
          "target": [
            "MatchResultList",
            "MatchResultObjectPage"
          ]
        }
      ],
      "targets": {
        "MatchResultList": {
          "type": "Component",
          "id": "MatchResultList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/MatchResult",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "MatchResult": {
                  "detail": {
                    "route": "MatchResultObjectPage"
                  }
                },
                "Payments": {
                  "detail": {
                    "route": "PaymentsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Multi",
                    "selectAll": true,
                    "enableExport": true,
                    "personalization": {
                      "column": true,
                      "sort": true,
                      "filter": true,
                      "group": true
                    }
                  }
                }
              }
            }
          },
          "controlAggregation": "beginColumnPages"
        },
        "MatchResultObjectPage": {
          "type": "Component",
          "id": "MatchResultObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/MatchResult"
            }
          },
          "controlAggregation": "midColumnPages"
        },
        "PaymentsList": {
          "type": "Component",
          "id": "PaymentsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Payments",
              "variantManagement": "None",
              "hideFilterBar": true,
              "initialLoad": "Enabled",
              "navigation": {
                "Payments": {
                  "detail": {
                    "route": "PaymentsObjectPage"
                  }
                },
                "OpenItem": {
                  "detail": {
                    "route": "OpenItemObjectPage"
                  }
                },
                "PipelineRuns": {
                  "detail": {
                    "route": "PipelineRunsObjectPage"
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "key": "OpenItemsTab",
                    "label": "{i18n>tabOpenItems}",
                    "entitySet": "OpenItem",
                    "contextPath": "/OpenItem",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#OpenItems"
                  },
                  {
                    "key": "PaymentsTab",
                    "label": "{i18n>tabAllPayments}",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#AllPayments"
                  },
                  {
                    "key": "MailsTab",
                    "label": "{i18n>tabMails}",
                    "entitySet": "IngestionLog",
                    "contextPath": "/IngestionLog",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Mails"
                  },
                  {
                    "key": "ClosedItemsTab",
                    "label": "{i18n>tabClosedItems}",
                    "entitySet": "OpenItem",
                    "contextPath": "/OpenItem",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#ClosedItems"
                  },
                  {
                    "key": "AiAnalyticsTab",
                    "label": "{i18n>tabAiAnalytics}",
                    "entitySet": "PipelineRuns",
                    "contextPath": "/PipelineRuns",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#PipelineRuns"
                  }
                ]
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Multi",
                    "selectAll": true,
                    "enableExport": true,
                    "personalization": {
                      "column": true,
                      "sort": true,
                      "filter": true,
                      "group": true
                    }
                  },
                  "actions": {
                    "uploadPayment": {
                      "press": "poc.cash.cashsyncui.ext.UploadPayment.onUploadPayment",
                      "text": "{i18n>actionUploadPayment}",
                      "requiresSelection": false
                    },
                    "revalidatePipeline": {
                      "press": "poc.cash.cashsyncui.ext.RevalidatePipeline.onRevalidatePipeline",
                      "text": "{i18n>actionRevalidatePipeline}",
                      "requiresSelection": false
                    }
                  }
                },
                "/OpenItem/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Multi",
                    "selectAll": true,
                    "enableExport": true,
                    "personalization": {
                      "column": true,
                      "sort": true,
                      "filter": true,
                      "group": true
                    }
                  },
                  "actions": {
                    "revalidatePipeline": {
                      "press": "poc.cash.cashsyncui.ext.RevalidatePipeline.onRevalidatePipeline",
                      "text": "{i18n>actionRevalidatePipeline}",
                      "requiresSelection": false
                    }
                  }
                },
                "/OpenItem/@com.sap.vocabularies.UI.v1.LineItem#Closed": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Multi",
                    "selectAll": true,
                    "enableExport": true,
                    "personalization": {
                      "column": true,
                      "sort": true,
                      "filter": true,
                      "group": true
                    }
                  }
                },
                "/IngestionLog/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None",
                    "enableExport": true,
                    "personalization": {
                      "column": true,
                      "sort": true,
                      "filter": true,
                      "group": true
                    }
                  }
                },
                "/PipelineRuns/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None",
                    "enableExport": true,
                    "personalization": {
                      "column": true,
                      "sort": true,
                      "filter": true,
                      "group": true
                    }
                  },
                  "actions": {
                    "showKpis": {
                      "press": "poc.cash.cashsyncui.ext.AiAnalyticsDashboard.onShowKpis",
                      "text": "{i18n>actionShowKpis}",
                      "requiresSelection": false
                    },
                    "refreshStats": {
                      "press": "poc.cash.cashsyncui.ext.AiAnalyticsDashboard.onRefreshStats",
                      "text": "{i18n>actionRefreshStats}",
                      "requiresSelection": false
                    }
                  }
                }
              }
            }
          },
          "controlAggregation": "beginColumnPages"
        },
        "PaymentsObjectPage": {
          "type": "Component",
          "id": "PaymentsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Payments",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.Facets": {
                  "sections": {
                    "sectionAiContext": {
                      "template": "poc.cash.cashsyncui.fragments.AIContextViewer",
                      "title": "{i18n>facetAiReasoningContext}",
                      "position": {
                        "placement": "After",
                        "anchor": "AiAnalyticsFacet"
                      }
                    },
                    "sectionPdfViewer": {
                      "template": "poc.cash.cashsyncui.fragments.PdfDocumentViewer",
                      "title": "{i18n>facetRemittancePdf}",
                      "position": {
                        "placement": "After",
                        "anchor": "sectionAiContext"
                      }
                    }
                  }
                },
                "matches/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Multi",
                    "selectAll": true,
                    "enableExport": true,
                    "personalization": {
                      "column": true,
                      "sort": true,
                      "filter": true,
                      "group": true
                    }
                  }
                }
              }
            }
          },
          "controlAggregation": "midColumnPages"
        },
        "OpenItemObjectPage": {
          "type": "Component",
          "id": "OpenItemObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/OpenItem",
              "controlConfiguration": {
                "proposedMatches/@com.sap.vocabularies.UI.v1.LineItem#OpenItemEvidence": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Single",
                    "enableExport": true,
                    "personalization": {
                      "column": true,
                      "sort": true,
                      "filter": true,
                      "group": true
                    }
                  }
                }
              }
            }
          },
          "controlAggregation": "midColumnPages"
        },
        "PipelineRunsObjectPage": {
          "type": "Component",
          "id": "PipelineRunsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/PipelineRuns"
            }
          },
          "controlAggregation": "midColumnPages"
        }
      }
    },
    "extends": {}
  }
}
