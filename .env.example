# Copy to root .env: cp .env.example .env — never commit real keys.
# Then: 1) configure AICORE_DESTINATION or AICORE_SERVICE_KEY below
#       2) restart the server (npm run dev).
CASH_AI_PROVIDER=aicore
S4_DESTINATION_NAME=HD0_BAS

# SAP AI Core (primary provider):
# Option 1: BTP Destination (with `cf login` and `cds bind -2 <destination-service-instance>`)
# AICORE_DESTINATION=AICORE_DESTINATION
# Option 2: Direct service key in .env (single line, single-quoted JSON)
# AICORE_SERVICE_KEY='{"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"ai_api_url":"..."}}'
# Option 3: Direct CF service binding (with `cds bind -2 <aicore-instance>`)
# AICORE_MODEL=anthropic--claude-4.5-sonnet
# AICORE_RESOURCE_GROUP=default

# Optional OpenRouter alternative: set CASH_AI_PROVIDER=openrouter.
# https://openrouter.ai/keys — paste your key here in .env, not this file.
# OPENROUTER_API_KEY=
# Choose a currently available model; PDF support and pricing must be checked.
# OPENROUTER_MODEL=provider/model-id
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# CF user-provided service name (default):
# CASH_AI_BINDING_NAME=poc-cash-ai
